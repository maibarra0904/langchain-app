# Google Gemini API Key (Obtén tu clave en https://aistudio.google.com/apikey)
GOOGLE_API_KEY="tu_api_key_aqui"
GEMINI_MODEL="gemini-3.5-flash"

# Configuración de Ollama (por defecto corre localmente en el puerto 11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Tavily Search API Key (Obtén tu clave en https://app.tavily.com)
TAVILY_API_KEY="tvly-tu_api_key_aqui"

# LangSmith para trazabilidad y depuración (https://smith.langchain.com)
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_tu_api_key_aqui"
LANGSMITH_PROJECT="langchain-app"

# Cloudinary Storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_cloudinary_api_key"
CLOUDINARY_API_SECRET="tu_cloudinary_api_secret"

# Supabase Database (https://supabase.com/dashboard)
SUPABASE_URL="https://tu_proyecto.supabase.co"
SUPABASE_KEY="tu_supabase_anon_o_service_key"

# Google OAuth 2.0 (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET es OPCIONAL (no es necesario si usas ID Token o Supabase Auth)
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8501"


