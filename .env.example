# Google Gemini API Key (Obtén tu clave en https://aistudio.google.com/apikey)
GOOGLE_API_KEY="tu_api_key_aqui"
GEMINI_MODEL="gemini-3.5-flash"

# Configuración de Ollama (por defecto corre localmente en el puerto 11434)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
# Ventana de contexto de Ollama (compartida con Hindsight para evitar recargas del modelo)
OLLAMA_NUM_CTX="8192"
# Máximo de tokens por respuesta (evita generaciones infinitas si el modelo entra en bucle)
OLLAMA_NUM_PREDICT="2048"

# Tavily Search API Key (Obtén tu clave en https://app.tavily.com)
TAVILY_API_KEY="tvly-tu_api_key_aqui"

# LangSmith para trazabilidad y depuración (https://smith.langchain.com)
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_tu_api_key_aqui"
LANGSMITH_PROJECT="langchain-app"

# Cloudinary Storage (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_cloudinary_api_key"
CLOUDINARY_API_SECRET="tu_cloudinary_api_secret"

# Supabase Database (https://supabase.com/dashboard)
SUPABASE_URL="https://tu_proyecto.supabase.co"
SUPABASE_KEY="tu_supabase_anon_o_service_key"

# Google OAuth 2.0 (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET es OPCIONAL (no es necesario si usas ID Token o Supabase Auth)
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8501"



# Hindsight - Memoria a largo plazo del agente (https://github.com/vectorize-io/hindsight)
# Arranca el servidor con ./scripts/start_hindsight.sh (sin Docker) o
# docker compose -f docker-compose.hindsight.yml up -d. Deja vacío para desactivar la memoria.
HINDSIGHT_API_URL="http://localhost:8888"
# Opcional: solo para Hindsight Cloud o servidores con autenticación
HINDSIGHT_API_KEY=""
# Opcional: LLM que usa el servidor Hindsight para extraer hechos (ollama | gemini).
# ollama: local y sin cuotas. gemini: más rápido, pero el plan gratuito (~20 peticiones/día) se agota enseguida.
HINDSIGHT_LLM_PROVIDER="ollama"
# Opcional: usar el "reflect" agéntico de Hindsight en "¿qué sabes de mí?" (requiere un LLM potente)
HINDSIGHT_REFLECT_ENABLED="false"
# Opcional: banco usado por el CLI (en la web cada usuario tiene su propio banco)
HINDSIGHT_BANK_ID="lagchain-default"
# Opcional: presupuesto de recall (low | mid | high) y tokens máximos de memoria inyectada
HINDSIGHT_RECALL_BUDGET="low"
HINDSIGHT_RECALL_MAX_TOKENS="1024"
# Opcional: URL de la UI web de Hindsight (solo con Docker, puerto 9999)
HINDSIGHT_UI_URL=""

# Sesión persistente (el login sobrevive a recargas de página)
# Clave secreta para firmar la cookie de sesión. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET="cambia_esto_por_una_clave_larga_y_aleatoria"
# Días que dura la sesión antes de pedir login de nuevo
SESSION_TTL_DAYS="7"
